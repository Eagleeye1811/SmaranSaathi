# Copy to frontend/.env and fill in real values there. frontend/.env is
# gitignored (via the root .gitignore's `.env` / `.env.*` rules) — never
# commit it.
#
# Flutter has no built-in `.env` reader — these values are compile-time
# `--dart-define`s (see lib/app/bootstrap.dart and lib/core/ai/ai_config.dart).
# `run_dev.ps1` reads this file and passes them through as dart-defines for
# you, so you never have to type them by hand.

# Where the FastAPI backend is reachable from the device/emulator you're
# running on:
#   Android emulator  -> http://10.0.2.2:8000
#   Physical device    -> http://127.0.0.1:8000  (after `adb reverse tcp:8000 tcp:8000`)
#   Chrome/desktop     -> http://127.0.0.1:8000
MM_SYNC_BASE_URL=http://10.0.2.2:8000

# From https://aistudio.google.com — real keys look like "AIzaSy...".
# Optional: the app falls back to on-device responses without one.
GEMINI_API_KEY=
