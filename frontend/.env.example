# Copy to frontend/.env and fill in real values there. frontend/.env is
# gitignored (via the root .gitignore's `.env` / `.env.*` rules) — never
# commit it.
#
# GEMINI_API_KEY (and the other AI_* / GEMINI_* keys in ai_config.dart) is
# read at runtime via flutter_dotenv (see lib/main.dart, lib/core/ai/
# ai_config.dart) — a plain `flutter run` picks it up with no extra flags.
# MM_SYNC_BASE_URL is the one exception: it stays a `--dart-define`-only
# override (see lib/app/bootstrap.dart) because its value here
# (10.0.2.2, an Android-emulator-only address) would break Chrome/desktop
# runs if it were loaded automatically on every platform. Leave it blank
# for a plain `flutter run`; pass it explicitly with `--dart-define` only
# when you deliberately want a non-default backend.

# Optional. The app defaults to the real deployed backend
# (https://smaransaathi-backend.onrender.com, hardcoded in bootstrap.dart)
# with no flags needed at all. Only set this if you want to point at a
# backend running on your own machine instead, while developing:
#   Android emulator  -> http://10.0.2.2:8000
#   Physical device    -> http://127.0.0.1:8000  (after `adb reverse tcp:8000 tcp:8000`)
#   Chrome/desktop     -> http://127.0.0.1:8000
# flutter run --dart-define=MM_SYNC_BASE_URL=http://10.0.2.2:8000
MM_SYNC_BASE_URL=

# From https://aistudio.google.com — real keys look like "AIzaSy...".
# Optional: the app falls back to on-device responses without one.
GEMINI_API_KEY=
