# ─────────────────────────────────────────────────────────────────────────
# Repository-wide ignores.
#
# Each project keeps its own rules as well:
#   frontend/.gitignore  — Flutter/Dart build output
#   backend/.gitignore   — added with the FastAPI service
# ─────────────────────────────────────────────────────────────────────────

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.history/

# Logs and scratch output
*.log
.env
.env.*
!.env.example

# ── Backend (FastAPI) — in place ahead of the service itself ─────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
backend/venv/
backend/env/
backend/build/
backend/dist/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/htmlcov/
backend/.coverage
backend/.coverage.*
backend/instance/
backend/*.db
backend/*.sqlite3
