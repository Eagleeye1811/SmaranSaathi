# Belt-and-suspenders with the root .gitignore, specifically for anything
# that could carry Firebase credentials — matched by pattern, not just by
# living in an ignored folder, so a misplaced copy is still caught.

.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

.env
.env.*
!.env.example

secrets/
*serviceAccountKey*.json
*firebase-adminsdk*.json
*-firebase-*.json

# Training run artifacts (backend/training/) — model weights, checkpoints and
# logs, not source. Multi-GB in practice (the merged model and GGUF export
# alone are ~2.4GB and ~800MB), so these must never be staged into git.
# (*.log itself is already covered by the root .gitignore.)
training/data/
training/install_log.txt
training/llama-3.2-1b-smaransaathi/
training/llama-3.2-1b-smaransaathi_gguf/
training/outputs/
training/unsloth_compiled_cache/
