# Copy to backend/.env and fill in real values there. backend/.env is
# gitignored — never commit it.

APP_NAME="MemoryMitra Backend"
APP_ENV=development
API_V1_PREFIX=/api/v1

# Comma-separated list of exact origins to allow beyond the dev localhost regex,
# e.g. a deployed web build's real domain. Pydantic-settings parses this as JSON
# or a comma-separated list depending on the field type — see core/config.py.
ALLOWED_ORIGINS=[]

# ── Phase 2: Firebase ──────────────────────────────────────────────────────
# From Firebase console → Project settings → General.
FIREBASE_PROJECT_ID=
# Path to the downloaded service-account JSON (Project settings → Service
# accounts → Generate new private key). Keep it outside version control —
# e.g. backend/secrets/firebase-service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=
# Project settings → General → Web API Key. Not a runtime secret (Firebase's
# own docs say this key is safe to expose) — used only by the test suite to
# mint a real ID token via REST, without any client SDK.
FIREBASE_WEB_API_KEY=

# ── Phase 3: device sync tokens ────────────────────────────────────────────
# A long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_JWT_SECRET=
